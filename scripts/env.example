# Copy to .env (never commit it). One line per inbox; generate the list with:
#   python -m coldflow inboxes env
# Values are app passwords (Google: myaccount.google.com/apppasswords). Microsoft inboxes use OAuth
# instead (python -m coldflow auth login) and need no line here.
CF_ALERT_PASSWORD=   # app password of the mailbox that sends you the daily summary (optional)
CF_PW_ALEX_AT_GETACME_MEDIA_COM=abcd efgh ijkl mnop
