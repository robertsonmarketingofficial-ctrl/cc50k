# coldflow schedule (crontab -e). Times are the server's local time; set the server to your
# sending timezone or adjust. Replace /opt/cc50k with your install path.
SHELL=/bin/bash

# Sending mornings: sweep replies, build the queue, send, refresh the dashboard.
30 7 * * 1-5  cd /opt/cc50k && set -a && source .env && set +a && python3 -m coldflow daily --live >> logs/daily.log 2>&1

# Midday and afternoon reply sweeps so opt-outs and replies stop sequences quickly.
0 12,16 * * 1-5  cd /opt/cc50k && set -a && source .env && set +a && python3 -m coldflow replies >> logs/replies.log 2>&1

# Weekly deep sweep for late bounces, plus a nightly database backup.
0 6 * * 1  cd /opt/cc50k && set -a && source .env && set +a && python3 -m coldflow replies --days 14 >> logs/replies.log 2>&1
0 23 * * *  cd /opt/cc50k && sqlite3 data/coldflow.db ".backup 'backups/coldflow-$(date +\%F).db'"
